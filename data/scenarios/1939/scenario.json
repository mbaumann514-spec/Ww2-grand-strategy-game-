  "plan": {
    "landsComment": "`lands` names land by the state of 1939 and the state it lies in today ('ROM/MDA' is Bessarabia): the map never lets a region cross a border of today, so the lines of 1939-45 that became borders are region borders.",
    "comment": "What each state did, and when, as the AI's intention: it acts on or soon after `date` if `when` holds. The human player's own state is never moved by the plan; he is shown these as decisions he may take. kind: war (a full declaration; alliances are drawn in), limited (a local war for named land: nobody else is drawn in, and it ends when the land is held), ultimatum (land demanded; refused, it is a limited war), join (enter a faction and its wars), cede (hand land over in peace).",
    "list": [
      { "id": "soviet_poland", "kind": "limited", "by": "SOV", "on": "POL", "date": "1939-09-17", "when": { "atWar": ["GER", "POL"], "lostVp": { "of": "POL", "share": 0.12 } },
        "lands": ["POL/BLR", "POL/UKR", "POL/LTU"], "regions": ["bialystok"],
        "comment": "The Red Army crossed the frontier on 17 September, when the Polish front had broken. The line of 28 September ran Pisa-Narew-Bug-San: Brest and Lwow Soviet, Lublin German." },
      { "id": "wilno_to_lithuania", "kind": "cede", "by": "SOV", "on": "LIT", "date": "1939-10-10", "when": { "controls": { "who": "SOV", "region": "wilno" } }, "regions": ["wilno"],
        "comment": "Treaty of 10 October 1939: Vilnius to Lithuania, Soviet garrisons in return." },
      { "id": "winter_war", "kind": "limited", "by": "SOV", "on": "FIN", "date": "1939-11-30", "when": { "notAtWar": ["SOV", "GER"] }, "regions": ["viipuri"],
        "comment": "30 November 1939 to 13 March 1940. The Peace of Moscow took the Karelian Isthmus with Viipuri and Ladoga Karelia; Petsamo stayed Finnish." },
      { "id": "weseruebung_den", "kind": "war", "by": "GER", "on": "DEN", "date": "1940-04-09", "when": { "atWar": ["GER", "ENG"] } },
      { "id": "weseruebung_nor", "kind": "war", "by": "GER", "on": "NOR", "date": "1940-04-09", "when": { "atWar": ["GER", "ENG"] } },
      { "id": "west_hol", "kind": "war", "by": "GER", "on": "HOL", "date": "1940-05-10", "when": { "atWar": ["GER", "FRA"] } },
      { "id": "west_bel", "kind": "war", "by": "GER", "on": "BEL", "date": "1940-05-10", "when": { "atWar": ["GER", "FRA"] } },
      { "id": "west_lux", "kind": "war", "by": "GER", "on": "LUX", "date": "1940-05-10", "when": { "atWar": ["GER", "FRA"] } },
      { "id": "italy_enters", "kind": "join", "by": "ITA", "faction": "AXIS", "date": "1940-06-10", "when": { "atWar": ["GER", "FRA"], "lostVp": { "of": "FRA", "share": 0.15 } },
        "comment": "Italy declared war on France and Britain on 10 June 1940, four days before Paris fell." },
      { "id": "baltic_est", "kind": "ultimatum", "by": "SOV", "on": "EST", "date": "1940-06-16", "annex": true, "when": { "notAtWar": ["SOV", "GER"] } },
      { "id": "baltic_lat", "kind": "ultimatum", "by": "SOV", "on": "LAT", "date": "1940-06-16", "annex": true, "when": { "notAtWar": ["SOV", "GER"] } },
      { "id": "baltic_lit", "kind": "ultimatum", "by": "SOV", "on": "LIT", "date": "1940-06-15", "annex": true, "when": { "notAtWar": ["SOV", "GER"] } },
      { "id": "bessarabia", "kind": "ultimatum", "by": "SOV", "on": "ROM", "date": "1940-06-26", "lands": ["ROM/UKR", "ROM/MDA"], "when": { "notAtWar": ["SOV", "GER"] },
        "comment": "Ultimatum of 26 June 1940: Bessarabia and northern Bukovina, occupied 28 June to 3 July." },
      { "id": "vienna_award", "kind": "cede", "by": "ROM", "on": "HUN", "date": "1940-08-30", "regions": ["oradea", "cluj"], "when": { "notAtWar": ["ROM", "HUN"] },
        "comment": "The Second Vienna Award: northern Transylvania to Hungary. DEVIATION: the award's line is not cut; the regions of Oradea and Cluj stand for it, so Turda goes over and the Szekler land does not." },
      { "id": "craiova", "kind": "cede", "by": "ROM", "on": "BUL", "date": "1940-09-07", "lands": ["ROM/BGR"], "when": { "notAtWar": ["ROM", "BUL"] },
        "comment": "The Treaty of Craiova: southern Dobruja to Bulgaria." },
